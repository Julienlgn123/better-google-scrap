# Clé x-api-key partagée par toutes les machines — génère une valeur aléatoire
# forte et garde-la identique partout (dispatcher, public-checker, chaque VM).
API_SECRET=

# Optionnel — voir deploy.sh pour les valeurs par défaut auto-détectées selon
# le nombre de cœurs de la machine.
MAX_BROWSERS=
MAX_TABS_PER_BROWSER=
